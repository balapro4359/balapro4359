# Copy to .env (never commit .env). All values are read by config/settings.py.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
DATABASE_URL=sqlite:///var/marketing.db
VAULT_ENCRYPTION_KEY=          # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEFAULT_MODEL=claude-opus-5
ENGINE=claude_sdk              # claude_sdk | fake
LOG_LEVEL=INFO
LOG_FORMAT=console             # console | json
RATE_LIMIT_PER_MINUTE=20
APPROVAL_TIMEOUT_SECONDS=900
